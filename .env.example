# Find-Meraki-Ports-With-MAC configuration template.
#
# This template is the ONLY env file tracked in the repo. The real file is
# per user and lives outside the repo, on your home drive:
#
#     H:\.env\meraki-ports-with-mac.env      (Windows: %HOMEDRIVE%\.env\...)
#     ~/.env/meraki-ports-with-mac.env       (macOS / Linux)
#
#   New-Item -ItemType Directory -Force 'H:\.env' | Out-Null
#   Copy-Item .env.example 'H:\.env\meraki-ports-with-mac.env'
#
# Never commit, email, or share the real file. Override its path with --env.

# Meraki Dashboard API key (required)
MERAKI_API_KEY=your_meraki_api_key
# Default organization name (optional; required if multiple orgs)
MERAKI_ORG=My Org
# Default network name or ALL
MERAKI_NETWORK=ALL
# Default output format: csv | text | html
OUTPUT_FORMAT=csv
# Override API base URL (optional)
MERAKI_BASE_URL=https://api.meraki.com/api/v1
# Log file path
LOG_FILE=Find-Meraki-Ports-With-MAC.log
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG
